<?xml version="1.0" encoding="utf-8"?>
<!-- The "the driver is near" screen: one glass panel, one accent action, and a
     quiet way out. Everything is Arabic and right-to-left, matching the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootArrival"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/arrival_backdrop"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/arrival_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="السائق قريب منك"
            android:textColor="#FFF3F3F5"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDriverName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="السائق"
            android:textColor="#FF5FD3E8"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="وصل لموقعك. إذا ما لقيتوش، عيّطله."
            android:textColor="#FFC4C4CD"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/arrival_call_button"
            android:text="اتصل بالسائق"
            android:textAllCaps="false"
            android:textColor="#FF08131A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/arrival_dismiss_button"
            android:text="واخا، شفتو"
            android:textAllCaps="false"
            android:textColor="#FFC4C4CD"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="يتسد وحدو بعد 60 ثانية"
            android:textColor="#FFA9A9B3"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

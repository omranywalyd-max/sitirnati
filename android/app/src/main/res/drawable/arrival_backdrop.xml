<?xml version="1.0" encoding="utf-8"?>
<!-- The same black-to-grey canvas the Flutter screens sit on, so the alert
     reads as part of the product rather than as a system dialog. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF000000"
        android:centerColor="#FF16161A"
        android:endColor="#FF0A0A0C"
        android:type="linear" />
</shape>
